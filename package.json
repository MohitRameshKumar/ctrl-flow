{
  "name": "cadence-collector",
  "description": "Cadence activity collector: records Chrome-only activity locally for routine detection.",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "build:test": "WXT_TEST=1 WXT_PROXY_URL=http://localhost:4411 WXT_PROXY_TOKEN=test-token wxt build",
    "test:no-test-hooks": "npm run build && node e2e/check-no-test-hooks.mjs",
    "test:e2e": "npm run test:no-test-hooks && npm run build:test && playwright test",
    "test:e2e:live": "playwright test --config=playwright.live.config.ts",
    "test:e2e:macros": "playwright test --config=playwright.macros.config.ts",
    "test:unit": "node --test \"tests/unit/*.test.ts\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "dexie": "^4.4.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/chrome": "^0.3.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "happy-dom": "^21.0.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  }
}
