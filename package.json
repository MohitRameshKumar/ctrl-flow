{
  "name": "cadence-collector",
  "description": "ctrl-flow: notices the routines you repeat in your browser and replays them (Chrome extension and desktop app).",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "build:test": "WXT_TEST=1 WXT_PROXY_URL=http://localhost:4411 WXT_PROXY_TOKEN=test-token wxt build",
    "test:no-test-hooks": "npm run build && node e2e/check-no-test-hooks.mjs",
    "test:e2e": "npm run test:no-test-hooks && npm run build:test && playwright test",
    "test:e2e:live": "playwright test --config=playwright.live.config.ts",
    "test:e2e:macros": "playwright test --config=playwright.macros.config.ts",
    "test:unit": "node --test \"tests/unit/*.test.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:desktop": "npm run build:injected && electron-vite dev",
    "build:desktop": "npm run build:injected && electron-vite build",
    "preview:desktop": "electron-vite preview",
    "compile:desktop": "tsc --noEmit -p desktop/tsconfig.json",
    "pack:desktop": "npm run build:desktop && electron-builder --dir",
    "dist:win": "npm run build:desktop && electron-builder --win --publish never",
    "dist:mac": "npm run build:desktop && electron-builder --mac --publish never",
    "build:injected": "vite build -c desktop/injected/vite.config.ts"
  },
  "dependencies": {
    "dexie": "^4.4.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/chrome": "^0.3.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@wxt-dev/module-react": "^1.1.5",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "happy-dom": "^21.0.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "web-ext": "^10.5.0",
    "ws": "^8.22.0",
    "wxt": "^0.21.3"
  },
  "main": "out/main/index.js"
}
